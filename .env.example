# Wake.ai — copy to .env; never commit secrets
WAKE_DATA_DIR=./data
WAKE_HOST=0.0.0.0
WAKE_PORT=8080
WAKE_RATE_LIMIT_JOBS_PER_HOUR=3
WAKE_MAX_RUNNING_PER_IP=1
WAKE_JOB_TIMEOUT_SEC=480
WAKE_CMD_TIMEOUT_SEC=60

# Sandbox (local Docker socket by default)
WAKE_DOCKER_HOST=unix:///var/run/docker.sock
WAKE_SANDBOX_IMAGE=wake-sandbox:local
WAKE_SANDBOX_RUNTIME=runsc
WAKE_SANDBOX_RUNTIME_FALLBACK=runc
WAKE_SANDBOX_MEMORY=512m
WAKE_SANDBOX_CPUS=1
WAKE_SANDBOX_PIDS=128
WAKE_SANDBOX_NETWORK_CLONE=bridge
WAKE_OUTPUT_MAX_BYTES=1048576

# Optional remote sandbox host (mTLS) — leave empty for local Docker
WAKE_SANDBOX_REMOTE_URL=
WAKE_SANDBOX_CLIENT_CERT=
WAKE_SANDBOX_CLIENT_KEY=
WAKE_SANDBOX_CA_CERT=

# LLM gateway — STUBBED until build week (3–8 Nov 2026). Do not put real keys in git.
# VULTR_INFERENCE_API_KEY=
# VULTR_INFERENCE_BASE_URL=
# VULTR_INFERENCE_MODEL=

WAKE_SPEND_CAP_JOBS=50
WAKE_REPLAY_DIR=./replay
