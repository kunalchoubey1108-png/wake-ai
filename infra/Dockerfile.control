FROM python:3.12-slim-bookworm
WORKDIR /app
COPY pyproject.toml README.md ./
COPY control_plane ./control_plane
COPY web ./web
COPY demo-repos ./demo-repos
COPY scripts ./scripts
RUN pip install --no-cache-dir fastapi 'uvicorn[standard]' sse-starlette pydantic pydantic-settings httpx python-multipart docker
ENV WAKE_DATA_DIR=/app/data
EXPOSE 8080
CMD ["uvicorn", "control_plane.api.app:app", "--host", "0.0.0.0", "--port", "8080"]
